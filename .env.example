# Configuration pour l'application Vaccination Web
# Copier ce fichier en .env.local et remplir les valeurs

# =============================================
# AUDIO & TRANSCRIPTION CONFIGURATION
# =============================================

# Provider de transcription: web-speech-api, google, azure, ou deepgram
VITE_TRANSCRIPTION_PROVIDER=web-speech-api

# Google Cloud Speech-to-Text
# 1. Créer un projet sur https://cloud.google.com
# 2. Activer l'API Speech-to-Text
# 3. Créer une clé API restrictive (Web API Key)
VITE_TRANSCRIPTION_API_KEY=your_google_api_key_here
VITE_GOOGLE_PROJECT_ID=your_project_id_here

# Azure Cognitive Services (Speech Services)
# 1. Créer une ressource "Speech Services" sur https://portal.azure.com
# 2. Récupérer la clé et la région
# 3. Format endpoint: https://{region}.stt.speech.microsoft.com
VITE_AZURE_ENDPOINT=https://eastus.stt.speech.microsoft.com
VITE_AZURE_REGION=eastus
VITE_AZURE_API_KEY=your_azure_api_key_here

# Deepgram (Premium speech recognition)
# 1. Créer un compte sur https://console.deepgram.com
# 2. Générer une clé API
VITE_DEEPGRAM_API_KEY=your_deepgram_api_key_here

# =============================================
# CHATBOT CONFIGURATION
# =============================================

# Mode chatbot: local, api, ou hybrid
VITE_CHATBOT_MODE=hybrid

# Endpoint API du chatbot (si mode api ou hybrid)
VITE_CHATBOT_API_URL=http://localhost:3001/api

# Langue par défaut
VITE_DEFAULT_LANGUAGE=fr-FR

# =============================================
# API CONFIGURATION
# =============================================

# URL de base pour les appels API
VITE_API_URL=http://localhost:5000/api

# Clé API (si nécessaire)
VITE_API_KEY=your_api_key_here

# =============================================
# NOTES D'IMPLÉMENTATION
# =============================================

# Web Speech API (Par défaut - Recommandé):
# - Gratuit et déjà intégré au navigateur
# - Fonctionne hors-ligne
# - Supporte Chrome, Edge, Safari, Firefox
# - Pas de clé API nécessaire
# - Limitations: Pas de sauvegarde de l'historique côté serveur

# Google Cloud Speech-to-Text:
# - Plus précis en reconnaissance vocale
# - Supporte 100+ langues
# - Facturé par utilisation (~$0.006 par minute)
# Quota gratuit: 60 minutes/mois
# Configuration: https://cloud.google.com/docs/authentication/rest

# Azure Cognitive Services:
# - Même niveau de précision que Google
# - Offre gratuite: 5h de reconnaissance/mois
# - Interface REST simple
# - Support professionnel inclus sur plans payants

# Deepgram:
# - IA moderne avec les meilleurs résultats
# - Gratuit: 50,000 requêtes/mois
# - Offre meilleure précision sur accents
# - Documentation: https://developers.deepgram.com

# =============================================
# RECOMMANDATIONS PRODUCTION
# =============================================

# 1. Utiliser Web Speech API pour DEV/DEMO (gratuit + rapide)
# 2. Passer à Deepgram ou Google pour PRODUCTION (meilleure précision)
# 3. Implémenter un proxy backend pour masquer les clés API
# 4. Ajouter rate limiting côté serveur
# 5. Logger les appels API pour analyse
# 6. Implémenter le cache pour les questions fréquentes
